# Document Ingestion Pipeline — environment contract
# Copy to .env and override for your deployment.

# --- Core services ---
TEMPORAL_HOST=localhost:7233
MARQO_URL=http://localhost:8882
MARQO_INDEX_NAME=documents-index
# #151: Marqo stays default until an explicit cutover. Keep the qdrant service
# running for shadow A/B. To flip: set VECTOR_STORE_BACKEND=qdrant and point
# QDRANT_INDEX_NAME at the populated collection (H100 example:
# amul-veterinary-rebuild-20260821-qdrant).
VECTOR_STORE_BACKEND=marqo
# In-compose URL (api/worker). Host-side scripts use http://127.0.0.1:6333 instead.
# Omit this var to let docker-compose.yml's http://qdrant:6333 fallback apply.
QDRANT_URL=http://qdrant:6333
QDRANT_INDEX_NAME=documents-index-qdrant
# Optional: enable Qdrant HTTP API-key auth (same value is passed into the qdrant container).
QDRANT_API_KEY=
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_URL=
EMBEDDING_API_KEY=
EMBEDDING_NORMALIZE=true
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
HF_HOME=/data/hf-cache
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=documents
DOCUMENT_DB_PATH=/data/documents.db
LANG_DETECT_URL=http://lang-detect:3000

# --- Host publish binds (compose) ---
# Defaults are loopback so vector DBs / API are not on the LAN or ingress path.
# In-compose traffic still uses service DNS (http://marqo:8882, http://qdrant:6333, http://api:8001).
# Set to 0.0.0.0:<port> only when you intentionally need remote host access
# (e.g. H100 when the reverse proxy / ingress runs on another machine).
MARQO_PUBLISH=127.0.0.1:8882
QDRANT_PUBLISH=127.0.0.1:6333
API_PUBLISH=127.0.0.1:8001
UI_PUBLISH=127.0.0.1:3000

# --- API docs (Swagger / OpenAPI / ReDoc) ---
# Compose defaults this to false so /docs and /openapi.json do not reveal the API surface.
# Set true for local interactive docs.
API_DOCS_ENABLED=false

# --- CORS / rate limits ---
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_UPLOAD=10/minute
ALLOWED_FILE_PATHS=/app/books,/data/documents

# --- OCR (Chandra) ---
OCR_PROVIDER=chandra
OCR_MODEL=chandra
CHANDRA_VLLM_BASE_URL=http://localhost:8010/v1
CHANDRA_INFERENCE_MODE=hf
CHANDRA_MAX_OUTPUT_TOKENS=12288
CHANDRA_OCR_MAX_WORKERS=4
CHANDRA_HF_HOME=
HF_HOME=

# --- Translation (Gemma vLLM) ---
TRANSLATION_PROVIDER=gemma_vllm
TRANSLATION_MODEL=gemma-4-31b-it
TRANSLATION_VLLM_BASE_URL=http://localhost:8020/v1
TRANSLATION_API_KEY=
TRANSLATION_PAGE_CONCURRENCY=1
TRANSLATION_MAX_RETRIES=6
TRANSLATION_RETRY_BASE_SECONDS=2.0
TRANSLATION_SCRIPT_GATE_ENABLED=true
TRANSLATION_SCRIPT_MIN_CHARS=15
TRANSLATION_SCRIPT_MIN_RATIO=0.05

# --- Domain tagging ---
DOMAIN_TAGGING_ENABLED=true
DOMAIN_TAGGING_PROVIDER=gemma_vllm
DOMAIN_TAGGING_MODEL=gemma-4-31b-it
DOMAIN_TAGGING_VLLM_BASE_URL=http://localhost:8020/v1
DOMAIN_TAGGING_STRICT_TAXONOMY=true
DOMAIN_TAXONOMY_PATH=

# --- Chunking ---
# CHUNKING_PROVIDER is required (no app-wide vendor default). Our deployment uses gemma_vllm.
# Providers: gemma_vllm | qwen_vllm | mistral_vllm | openai_vllm | deterministic
CHUNKING_PROVIDER=gemma_vllm
# Must match the exact model id served by CHUNKING_VLLM_BASE_URL (confirm via /v1/models).
CHUNKING_MODEL=gemma-4-31b-it
CHUNKING_VLLM_BASE_URL=http://localhost:8020/v1
CHUNKING_API_KEY=
CHUNKING_FALLBACK_PROVIDER=deterministic
CHUNKING_TARGET_CHUNK_TOKENS=450
CHUNKING_MAX_CHUNK_TOKENS=450
CHUNKING_MIN_CHUNK_TOKENS=100
CHUNKING_OVERLAP_TOKENS=128
CHUNKING_MAX_PAGES_PER_CHUNK=8
CHUNKING_PAGE_WINDOW_SIZE=8
CHUNKING_QWEN_ENABLE_THINKING=false
# Durable chunk checkpointing for long LLM chunk runs (#125). Checkpointing only
# engages for LLM grouping providers on documents of at least MIN_PAGES pages;
# WINDOWS is how many provider windows buffer before a flush to SQLite.
CHUNKING_CHECKPOINT_WINDOWS=25
CHUNKING_CHECKPOINT_MIN_PAGES=500
TEMPORAL_MAX_CONCURRENT_ACTIVITIES=4

# --- Document metadata (optional) ---
DOCUMENT_METADATA_CSV_PATH=/app/workspace/document_manifest.csv
DOCUMENT_DESCRIPTIONS_JSONL_PATH=/app/workspace/document_descriptions.jsonl

# --- Provenance / UI link builders (optional) ---
DOCS_PIPELINE_API_URL=http://localhost:8001
DOCS_PIPELINE_UI_URL=http://localhost:3000

DOMAIN_TAGGING_CONCURRENCY=4

# --- Auth / Keycloak 26 (backend gates + tenant control node) ---
# Keycloak image is pinned to 26.x in docker-compose.yml (Organizations require 26+).
# Organizations are enabled via KC_FEATURES=organization; the proxy setting is the 26 form
# KC_PROXY_HEADERS=xforwarded (replaces the old KC_PROXY=edge). Both live in docker-compose.yml.
# CLEAN REDEPLOY: on the 22 -> 26 cutover, wipe KEYCLOAK_DB_DATA_PATH so the fresh realm imports.
#
# true = local bypass (synthetic master_admin). Loud WARNING is printed on API startup.
# Do NOT set false until the maintainer UI sends Authorization: Bearer <token>.
AUTH_DISABLED=true
# Document Ops live progress bar. Off by default. When true, GET /runtime
# includes a `progress` object assembled from SQLite + Temporal heartbeats.
LIVE_PROGRESS_UI_ENABLED=false
# Restricted search on an index with no filterable `instance` field is fail-closed
# (empty results). Set true only as an emergency for a known single-tenant legacy
# index that cannot be rebuilt yet. Off by default (#134).
ALLOW_UNSCOPED_LEGACY_SEARCH=false
# Must match the `iss` claim in tokens (usually the URL you use to request the token).
KEYCLOAK_ISSUER=http://localhost:8082/auth/realms/docs-pipeline
KEYCLOAK_AUDIENCE=docs-pipeline-api
# In-compose default (see docker-compose.yml). Override if Keycloak is external.
KEYCLOAK_JWKS_URL=http://keycloak:8080/auth/realms/docs-pipeline/protocol/openid-connect/certs
KEYCLOAK_JWT_LEEWAY_SECONDS=30
KEYCLOAK_PORT=8082
# --- Admin API service account (backend creates orgs/users/groups via KC Admin API) ---
# The realm ships a confidential service-account client `docs-pipeline-admin`
# (serviceAccountsEnabled) whose service account holds the realm-management
# `realm-admin` role. The backend does a client_credentials grant with the id +
# secret below and calls the Admin API. The realm export ships a PLACEHOLDER
# secret ("CHANGE_ME_ADMIN_SECRET") — regenerate the real one at deploy and paste
# it here. Obtain it with:
#   python scripts/keycloak_bootstrap_docs_pipeline.py --print-admin-secret
#   (add --regenerate-admin-secret to rotate + print a fresh one)
KEYCLOAK_ADMIN_CLIENT_ID=docs-pipeline-admin
# Leave EMPTY here; set the real value at deploy (never commit it).
KEYCLOAK_ADMIN_CLIENT_SECRET=
# Realm the Admin API calls target (and the client lives in).
KEYCLOAK_REALM=docs-pipeline
# --- Browser-facing UI origin (redirect-URI-per-deployment) ---
# The public URL where the operator UI is served (scheme+host, e.g. https://ui.example.com).
# A clean realm import only allows the wildcard/localhost redirect patterns from the export,
# so browser login 400s ("Invalid parameter: redirect_uri") on your real origin until it is
# added to the docs-pipeline-ui client. scripts/deploy_bootstrap.sh reads this and adds it
# (idempotently) at deploy — set it, then run the deploy bootstrap. Space/comma-separated
# for multiple origins. Leave commented for pure localhost dev (localhost is already allowed).
# UI_PUBLIC_URL=https://ui.example.com
# Base URL the backend uses to reach Keycloak for Admin API / token calls.
# In-compose default; override if Keycloak is external.
KEYCLOAK_ADMIN_BASE_URL=http://keycloak:8080/auth
# Initial admin creds. KC 26 consumes these via KC_BOOTSTRAP_ADMIN_USERNAME/PASSWORD
# (docker-compose.yml maps these vars); the bootstrap script also reads them to call the Admin API.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
# Keycloak Postgres data directory. Point at a large-capacity volume, e.g.:
# KEYCLOAK_DB_DATA_PATH=/mnt/data/docs-pipeline/keycloak/postgres
KEYCLOAK_DB_DATA_PATH=./data/keycloak-db
# Default tenant/instance for new docs and legacy NULL/empty rows (migration backfills this).
# Keep as "default" unless you also backfill existing rows to the new value.
DEFAULT_INSTANCE=default

# --- Search namespacing (Phase 4, not yet active) ---
# Future per-tenant Marqo index naming: index_for_instance(i) = f"{MARQO_INDEX_NAMESPACE}{i}".
# Left commented until the search-isolation phase lands; MARQO_INDEX_NAME stays the default/fallback.
# MARQO_INDEX_NAMESPACE=t-
