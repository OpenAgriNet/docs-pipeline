# Document Ingestion Pipeline — environment contract
# Copy to .env and fill secrets for your deployment.
# Used by: docker compose -f docker-compose.prod.yml --env-file .env

# --- Core services ---
# TEMPORAL_HOST / MINIO_ENDPOINT / LANG_DETECT_URL are overridden inside
# docker-compose.prod.yml to Docker service DNS (temporal, minio, lang-detect).
TEMPORAL_HOST=localhost:7233
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=documents
DOCUMENT_DB_PATH=./data/documents.db
LANG_DETECT_URL=http://localhost:3001

# --- Vector backend (Qdrant) ---
VECTOR_BACKEND=qdrant
# Local: http://localhost:6333
# Remote reverse-proxy: https://dev-vistaar.da.gov.in/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=test_doc_pipeline
QDRANT_TIMEOUT_SECONDS=30

# --- PROD Qdrant (Approval for Prod promotion target) ---
PROD_VECTOR_BACKEND=qdrant
PROD_QDRANT_URL=https://dev-vistaar.da.gov.in/qdrant
PROD_QDRANT_API_KEY=
PROD_QDRANT_COLLECTION_NAME=test_doc_pipeline_prod
PROD_QDRANT_TIMEOUT_SECONDS=30

# --- Embeddings ---
# Default: local SentenceTransformer (requires sentence-transformers in the image).
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024
EMBEDDING_VECTOR_SIZE=1024
# Prefer remote embeddings on slim/CPU hosts (skips torch in the worker):
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_BASE_URL=https://dev-vistaar.da.gov.in/<embeddings>/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=intfloat/multilingual-e5-large

# --- Hugging Face (local SentenceTransformer model download/cache) ---
HF_TOKEN=
HF_HOME=/opt/hf-cache
# Host path is bind-mounted into api/worker at the same path.
# On server: sudo mkdir -p /opt/hf-cache && sudo chown -R 1000:1000 /opt/hf-cache
# (or chown to the uid the container runs as)

# --- CORS / limits ---
# Browser origins allowed to call the API (comma-separated, no spaces preferred).
# Production registry:
CORS_ORIGINS=https://registry-sandbox-vistaar.da.gov.in
# Local UI: CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_UPLOAD=10/minute
ALLOWED_FILE_PATHS=./books,./data/documents

# --- OCR (Mistral Document AI) ---
OCR_PROVIDER=mistral
OCR_MODEL=mistral-ocr-latest
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_OCR_API_URL=https://api.mistral.ai/v1/ocr
OCR_SEGMENT_PAGES=20
OCR_REQUEST_TIMEOUT_SECONDS=300
# Alternatives: OCR_PROVIDER=mock|pypdf|chandra

# --- LLM: Gemma 4 (translation + domain tagging) ---
AGRINET_GEMMA_BASE_URL=https://dev-vistaar.da.gov.in/gemma4
AGRINET_GEMMA_MODEL_NAME=google/gemma-4-31b-it
# Optional if gateway needs a key:
# AGRINET_GEMMA_API_KEY=

TRANSLATION_PROVIDER=gemma_vllm
TRANSLATION_MODEL=google/gemma-4-31b-it
TRANSLATION_VLLM_BASE_URL=https://dev-vistaar.da.gov.in/gemma4
TRANSLATION_PAGE_CONCURRENCY=1

# Regex script gate — only pages containing non-Latin (Indic) script are sent
# to the translation model. Set false to fall back to per-line lang-detect,
# which misreads OCR noise as European languages and translates English pages.
TRANSLATION_SCRIPT_GATE_ENABLED=true
TRANSLATION_SCRIPT_MIN_CHARS=15
TRANSLATION_SCRIPT_MIN_RATIO=0.05

DOMAIN_TAGGING_ENABLED=true
DOMAIN_TAGGING_PROVIDER=gemma_vllm
DOMAIN_TAGGING_MODEL=google/gemma-4-31b-it
DOMAIN_TAGGING_VLLM_BASE_URL=https://dev-vistaar.da.gov.in/gemma4
DOMAIN_TAGGING_STRICT_TAXONOMY=true

# --- Chunking ---
CHUNKING_PROVIDER=recursive_splitter
CHUNKING_MODEL=recursive_splitter
CHUNKING_TARGET_CHUNK_TOKENS=450
TEMPORAL_MAX_CONCURRENT_ACTIVITIES=4

# --- Host port binds (localhost only; for host nginx) ---
# Chosen to avoid clashes on shared registry host:
#   oan-redis          → 8001
#   bharat-vistaar-docs-nginx → 8088
#   keycloak           → 8081
#   notification svc   → 8082
API_HOST_PORT=8011
UI_HOST_PORT=3011
TEMPORAL_UI_PORT=8090
# temporal-ui is under compose profile "ops" — start with:
#   docker compose -f docker-compose.prod.yml --profile ops up -d temporal-ui

# --- App URLs (public, after nginx) ---
DOCS_PIPELINE_API_URL=https://registry-sandbox-vistaar.da.gov.in/docs-pipeline-api
DOCS_PIPELINE_UI_URL=https://registry-sandbox-vistaar.da.gov.in/docs-pipeline

# --- Pipeline stages ---
# true  = documents finish at DEV ingest; the "Approve for production" and
#         "Publishing to prod" stages are skipped entirely.
# false = full pipeline, ending with a superadmin PROD promotion.
# Read when a workflow starts — documents already in flight keep the shape
# they began with.
DISABLE_PROD_SETTING=false

# --- Auth / Keycloak (API) ---
AUTH_DISABLED=false
# Platform realm with Google SSO (multi-state groups on this realm)
KEYCLOAK_ISSUER=https://dev-auth-vistaar.da.gov.in/auth/realms/bharat-vistaar
KEYCLOAK_AUDIENCE=
KEYCLOAK_JWKS_URL=https://dev-auth-vistaar.da.gov.in/auth/realms/bharat-vistaar/protocol/openid-connect/certs
DEFAULT_INSTANCE=default

# Super-admin Users UI → Keycloak Admin API (create users / groups)
# Use a Keycloak admin that can manage realm bharat-vistaar (often master admin).
# KEYCLOAK_ADMIN_BASE_URL=https://dev-auth-vistaar.da.gov.in/auth
# KEYCLOAK_ADMIN_REALM=bharat-vistaar
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=
# KEYCLOAK_ADMIN_TOKEN_REALM=master

# The ONE Keycloak client behind both login paths. It must be CONFIDENTIAL:
#   - the email-otp extension rejects public clients outright, and
#   - Google SSO therefore cannot exchange its code in the browser either, so
#     the UI posts the code to POST /auth/sso/exchange and the API completes it.
# Required on this client in Keycloak:
#   Client authentication ON  (confidential)
#   Standard flow ON          (browser gets the code; the API redeems it)
#   Direct access grants ON, with
#     Advanced → Authentication flow overrides → Direct grant = email-otp-direct-grant
#   Valid redirect URIs must include <ui-origin>/auth/sso-callback
#
# ⚠ DEPLOY NOTE: on the prod Keycloak (auth-vistaar.da.gov.in) this client is
# currently PUBLIC. It must be switched to confidential and its secret put in
# KEYCLOAK_CLIENT_SECRET before this build goes out, or BOTH logins will fail.
#
# VITE_KEYCLOAK_CLIENT_ID below must name this same client.
# Defaults to VITE_KEYCLOAK_CLIENT_ID when KEYCLOAK_CLIENT_ID is unset.
KEYCLOAK_CLIENT_ID=bharat-vistaar
KEYCLOAK_CLIENT_SECRET=
# Unauthenticated and sends real email, so keep this tight.
RATE_LIMIT_OTP=10/minute

# --- UI build args (baked into Vite at image build time) ---
VITE_API_BASE=/docs-pipeline-api
VITE_BASE=/docs-pipeline/
VITE_AUTH_ENABLED=true
VITE_KEYCLOAK_URL=https://dev-auth-vistaar.da.gov.in/auth
VITE_KEYCLOAK_REALM=bharat-vistaar
VITE_KEYCLOAK_CLIENT_ID=bharat-vistaar
VITE_KEYCLOAK_IDP_HINT=google

# Super-admin Users UI (Keycloak Admin API)
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=

# --- Master Catalog (Postgres) ---
# code/name/tool_name/prompt_snippet, synced on DEV ingest (status=dev)
# and PROD promote (status=live). No DB container is provisioned in docker-compose —
# point these at your existing Postgres instance (any host/server is fine; this just
# needs its own database + user on it, e.g. `CREATE DATABASE master_catalog`).
MASTER_CATALOG_PG_HOST=
MASTER_CATALOG_PG_PORT=5432
MASTER_CATALOG_PG_DB=master_catalog
MASTER_CATALOG_PG_USER=master_catalog
MASTER_CATALOG_PG_PASSWORD=
MASTER_CATALOG_PG_SSLMODE=disable

# --- AI layer Redis (bharat-oan-api) ---
# docs-pipeline pushes the catalog snapshot directly into this Redis instance
# after every Postgres sync. Leave AI_LAYER_REDIS_HOST empty to disable the
# push (Postgres sync still happens; only the Redis mirror is skipped).
AI_LAYER_REDIS_HOST=
AI_LAYER_REDIS_PORT=6379
AI_LAYER_REDIS_DB=0
AI_LAYER_REDIS_PASSWORD=
MASTER_CATALOG_REDIS_TTL_SECONDS=172800

